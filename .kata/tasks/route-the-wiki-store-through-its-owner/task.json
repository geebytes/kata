{
  "id": "route-the-wiki-store-through-its-owner",
  "title": "Route the Wiki record store through its owner",
  "phase": "intake",
  "engine": {
    "version": "0.2.0",
    "stampedAt": "2026-10-06T06:50:20.960Z"
  },
  "acceptance": [
    {
      "id": "AC-1",
      "statement": "The Wiki record store is derived from the checkout that owns the task's records, not from the caller's root: the same directory is answered from the primary checkout and from inside a linked worktree, and no second copy of the store is created under the worktree."
    },
    {
      "id": "AC-2",
      "statement": "A Wiki closure that names a registered candidate evaluates valid when the task is verified from inside its linked worktree, and a candidate that is genuinely absent still fails closed with candidate_missing."
    },
    {
      "id": "AC-3",
      "statement": "For a task whose records and code live in one checkout, the store's location and contents are unchanged: every existing reader and writer resolves the same file as before, and no record is moved or rewritten by this change."
    }
  ],
  "branch": "master",
  "createdAt": "2026-10-06T06:50:20.960Z",

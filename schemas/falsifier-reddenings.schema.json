{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "falsifier-reddenings",
  "title": "Falsifier reddenings",
  "description": "The record that a finding's falsifier was shown reddening: the check passed, the defect was re-introduced and the check failed, and the restore brought it back. Written by `kata-cli falsify`, which runs the three steps and records what it observed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reddenings",
    "updatedAt"
  ],
  "properties": {
    "reddenings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "check",
          "mutation",
          "revisionId",
          "reddenedAt",
          "observed"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "revisionId": {
            "type": "string",
            "minLength": 1
          },
          "reddenedAt": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "mutated",
              "after"
            ],
            "properties": {
              "before": {
                "type": "integer"
              },
              "mutated": {
                "type": "integer"
              },
              "after": {
                "type": "integer"
              }
            }
          },
          "observedTreeDigest": {
            "type": "string"
          },
          "observedDrift": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pathDigests": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "The content the three steps ran against — the files this proof is about, and the binding the closure criterion prefers. `revisionId` is the fallback, because a seal's id derives from every content digest it sees (measured: 718), so binding to it expired proofs about files a later commit never touched."
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "absences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "reason",
          "revisionId",
          "recordedAt"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "revisionId": {
            "type": "string",
            "minLength": 1
          },
          "recordedAt": {
            "type": "string",
            "minLength": 1
          },
          "pathDigests": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "The content the recorded absence is about, for the same reason a reddening carries it."
          }
        }
      }
    }
  }
}

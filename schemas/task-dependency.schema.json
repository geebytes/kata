{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.dev/schemas/task-dependency.schema.json",
  "title": "Task dependency returns",
  "description": "The return evidence of a task-to-task blocking edge. The graph keeps the topology (which task is blocked by which) and this record keeps only what the topology cannot: that the corrective work was independently certified, that its accepted content is in the dependent tree, and which dependent revision the return was recorded against. Endpoints are deliberately absent so this file cannot become a second topology.",
  "type": "object",
  "required": ["taskId", "updatedAt", "returns"],
  "additionalProperties": false,
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "returns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationId",
          "correctiveTaskId",
          "correctiveRevisionId",
          "integratedContentHash",
          "recordedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "relationId": { "type": "string", "minLength": 1 },
          "correctiveTaskId": { "type": "string", "minLength": 1 },
          "correctiveRevisionId": { "type": "string", "minLength": 1 },
          "integratedContentHash": { "type": "string", "minLength": 1 },
          "subjectRevisionId": { "type": "string", "minLength": 1 },
          "recordedAt": { "type": "string", "minLength": 1 },
          "recordedBy": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

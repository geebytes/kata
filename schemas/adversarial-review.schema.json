{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.dev/schemas/adversarial-review.schema.json",
  "title": "Kata independent adversarial review record",
  "description": "One adversarial pass over a sealed revision, executed in a clean context. `status: recorded` carries what the adversarial reviewer attempted and found; `status: waived` records an explicit decision to proceed without it. Whether the pass really ran in a fresh context is attested by the executing agent — kata can gate on the attestation and on the brief it was given, not on the host's session.",
  "type": "object",
  "required": [
    "node",
    "status",
    "revisionId",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "node": {
      "type": "string",
      "enum": [
        "verify",
        "review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "waived"
      ]
    },
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "manifestHash": {
      "type": "string"
    },
    "baseManifestHash": {
      "type": "string",
      "description": "For a delta pass: the manifest hash whose change surface this pass measured."
    },
    "scope": {
      "description": "What the pass covered: full means every path was re-derived; delta means only changedPaths were.",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "full",
            "delta"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "elapsedMs": {
      "description": "How long the pass took, reported by the executor. Recorded so a delta pass can be compared with the full pass it narrowed (design §11: the saving had never been measured).",
      "type": "integer"
    },
    "toolUses": {
      "description": "How many tool calls the pass made, reported by the executor. The turn loop, not the CPU, is what a pass mostly costs (design §1), so this is the first term of that cost to become visible.",
      "type": "integer"
    },
    "executedInFreshContext": {
      "type": "boolean"
    },
    "contextNote": {
      "type": "string",
      "minLength": 1
    },
    "briefSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "no_defect_found",
        "defects_found",
        "inconclusive"
      ]
    },
    "executedBy": {
      "type": "string",
      "minLength": 1
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hypothesis",
          "method",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "refuted",
              "confirmed",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "taskId",
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "nit"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "open",
              "fixed",
              "deferred",
              "accepted"
            ]
          },
          "dispositionReason": {
            "type": "string",
            "minLength": 1
          },
          "dispositionBy": {
            "type": "string",
            "minLength": 1
          },
          "dispositionAt": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findingOrigins": {
      "description": "How many of this pass's findings were caused by the previous repair (design §F3): recorded so the marginal cost of fixing is on the same account as the cost of finding.",
      "type": "object",
      "required": [
        "causedByPreviousRepair"
      ],
      "additionalProperties": false,
      "properties": {
        "causedByPreviousRepair": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "waivedReason": {
      "type": "string",
      "minLength": 1
    },
    "waivedBy": {
      "type": "string",
      "minLength": 1
    }
  }
}

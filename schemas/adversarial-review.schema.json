{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.dev/schemas/adversarial-review.schema.json",
  "title": "Kata independent adversarial review record",
  "description": "One adversarial pass over a sealed revision, executed in a clean context. `status: recorded` carries what the adversarial reviewer attempted and found; `status: waived` records an explicit decision to proceed without it. Whether the pass really ran in a fresh context is attested by the executing agent — kata can gate on the attestation and on the brief it was given, not on the host's session.",
  "type": "object",
  "required": [
    "node",
    "status",
    "revisionId",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "node": {
      "type": "string",
      "enum": [
        "verify",
        "review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "waived"
      ]
    },
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "manifestHash": {
      "type": "string"
    },
    "candidateFreezeSha256": {
      "description": "The CandidateFreeze this pass certified (§7.4): the content snapshot plus the semantic contract it answered. Stamped so a completed certification can be reused for the freezes it is still valid for, instead of being expired by a revision id that moves on any re-seal.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "codeManifestHash": {
      "description": "Content identity of the revision's code paths only (C2). Stamped beside manifestHash so a code-scoped verdict can outlive a governance-text edit; absent when the split cannot be derived, in which case a code-scoped binding refuses to match.",
      "type": "string"
    },
    "governanceManifestHash": {
      "description": "The governance-text surface at the time of this verdict (§22/§24). A text-only edit expires what this surface was verified for, and nothing else.",
      "type": "string"
    },
    "instrumentManifestHash": {
      "description": "The declared-instrument surface at the time of this verdict (§24.4). Editing a declared instrument expires the instrument surface only — not the pass about the deliverable.",
      "type": "string"
    },
    "baseManifestHash": {
      "type": "string",
      "description": "For a delta pass: the manifest hash whose change surface this pass measured."
    },
    "scope": {
      "description": "What the pass covered: full means every path was re-derived; delta means only changedPaths were.",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "full",
            "delta"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "elapsedMs": {
      "description": "How long the pass took, reported by the executor. Recorded so a delta pass can be compared with the full pass it narrowed (design §11: the saving had never been measured).",
      "type": "integer"
    },
    "toolUses": {
      "description": "How many tool calls the pass made, reported by the executor. The turn loop, not the CPU, is what a pass mostly costs (design §1), so this is the first term of that cost to become visible.",
      "type": "integer"
    },
    "mode": {
      "description": "How the round was framed (M2): verify lists the author's claims, cold lists none. The platform rotates the default and records it here, because the next rotation reads it.",
      "type": "string",
      "enum": [
        "verify",
        "cold"
      ]
    },
    "executedInFreshContext": {
      "type": "boolean"
    },
    "contextNote": {
      "type": "string",
      "minLength": 1
    },
    "briefSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "no_defect_found",
        "defects_found",
        "inconclusive"
      ]
    },
    "executedBy": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "description": "The judgement basis: what the reviewer asserted, over what, by which method, and what it observed. The verdict is derived from these by kata; `verdict` is a display field that may not contradict them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "targets",
          "method",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "method": {
            "type": "string",
            "enum": [
              "mutation",
              "source-read",
              "sealed-evidence",
              "permitted-test",
              "deterministic-analysis"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "refuted",
              "confirmed",
              "ruled_out",
              "abandoned",
              "inconclusive"
            ]
          },
          "observation": {
            "type": "object",
            "required": [
              "kind",
              "ref",
              "observed"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "source",
                  "evidence",
                  "test",
                  "analysis"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "observed": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "abandoned": {
            "type": "object",
            "required": [
              "limit",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "limit": {
                "type": "string",
                "enum": [
                  "budget",
                  "time",
                  "tools"
                ]
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "receipt": {
      "description": "The executor's report that fresh context was a *capability* rather than an assertion. Written by the host, never by the reviewer; the gate refuses a record whose receipt does not bind to the issued request by nonce and hash, or whose capabilities omit what the node requires.",
      "type": "object",
      "required": [
        "runId",
        "requestSha256",
        "capabilities",
        "startedAt",
        "endedAt",
        "telemetry",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "fresh_context",
              "read_only_fs",
              "bounded_tools",
              "budget_enforced"
            ]
          }
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "endedAt": {
          "type": "string",
          "minLength": 1
        },
        "telemetry": {
          "type": "object",
          "required": [
            "toolCalls",
            "outputBytes",
            "tokens",
            "truncations"
          ],
          "additionalProperties": false,
          "properties": {
            "toolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "truncations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "budget_exhausted",
            "timeout",
            "cancelled",
            "executor_unavailable"
          ]
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hypothesis",
          "method",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "refuted",
              "confirmed",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "toolUses": {
            "description": "How many tool calls this attempt took (§18.7). Per attempt rather than per pass so a costly hypothesis is visible while it runs, which is when the decision to stop is made.",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "taskId",
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "nit"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "open",
              "fixed",
              "deferred",
              "accepted"
            ]
          },
          "dispositionReason": {
            "type": "string",
            "minLength": 1
          },
          "dispositionBy": {
            "type": "string",
            "minLength": 1
          },
          "dispositionAt": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findingOrigins": {
      "description": "How many of this pass's findings were caused by the previous repair (design §F3): recorded so the marginal cost of fixing is on the same account as the cost of finding.",
      "type": "object",
      "required": [
        "causedByPreviousRepair"
      ],
      "additionalProperties": false,
      "properties": {
        "causedByPreviousRepair": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "waivedReason": {
      "type": "string",
      "minLength": 1
    },
    "waivedBy": {
      "type": "string",
      "minLength": 1
    },
    "testPolicy": {
      "type": "string",
      "const": "reuse_declared_tests_only"
    }
  }
}

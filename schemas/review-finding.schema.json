{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.dev/schemas/review-finding.schema.json",
  "title": "Kata Review Finding",
  "type": "object",
  "required": [
    "id",
    "taskId",
    "severity",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceId": {
      "type": "string",
      "pattern": "^AC-[0-9]+$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocking",
        "major",
        "minor",
        "note",
        "nit"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "reproduction": {
      "type": "object",
      "required": [
        "findingId",
        "ranChecks",
        "missingTest"
      ],
      "additionalProperties": false,
      "properties": {
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "ranChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "checkId",
              "passed"
            ],
            "additionalProperties": false,
            "properties": {
              "checkId": {
                "type": "string",
                "minLength": 1
              },
              "testSelector": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              }
            }
          }
        },
        "missingTest": {
          "type": "boolean"
        }
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "open",
        "fixed",
        "deferred",
        "accepted",
        "routed"
      ],
      "description": "Set by a disposition command (`findings defer|accept|rout`) or by the closure rule marking a finding fixed. Absent means open — a record that carries no disposition has not been decided, which is different from one disposed of as nothing."
    },
    "dispositionReason": {
      "type": "string",
      "minLength": 1
    },
    "dispositionBy": {
      "type": "string",
      "minLength": 1
    },
    "dispositionAt": {
      "type": "string",
      "minLength": 1
    }
  }
}

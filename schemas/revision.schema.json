{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.dev/schemas/revision.schema.json",
  "title": "Kata task revision",
  "type": "object",
  "required": ["id", "taskId", "ownedPaths", "manifestHash", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^revision-" },
    "taskId": { "type": "string", "minLength": 1 },
    "ownedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAt": { "type": "string", "minLength": 1 },
    "ownershipConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "path"],
        "additionalProperties": false,
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ownershipConflictsAcknowledged": { "type": "boolean" }
  }
}

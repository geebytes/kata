{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.dev/schemas/revision.schema.json",
  "title": "Kata task revision",
  "type": "object",
  "required": [
    "id",
    "taskId",
    "ownedPaths",
    "manifestHash",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^revision-"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "ownedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pathDigests": {
      "type": "object",
      "description": "Per-path content digests of the owned set at seal time, so a later pass can ask what changed. Absent on revisions sealed before the field existed (delta_unavailable).",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "contentDigests": {
      "type": "object",
      "description": "Immutable full content snapshot at seal time; absent only on legacy revisions that predate content-bound identity.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "ownershipConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ownershipConflictsAcknowledged": {
      "type": "boolean"
    },
    "pathKinds": {
      "type": "object",
      "description": "What each declared path was at seal time \u2014 `content`, `directory`, `missing` or `unsupported`. The content map is silent when a path keeps its bytes but changes kind, so a drift verdict needs this to name that comparison. Absent on revisions sealed before it existed.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "content",
          "directory",
          "missing",
          "unsupported"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scope-changes",
  "type": "object",
  "required": [
    "changes",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "by",
          "reason",
          "added",
          "removed",
          "scope"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "added": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "description": "The complete scope this change resulted in. Recorded rather than reconstructed: a diff cannot say what the scope was before the first change, and guessing would report the original scope as growth.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "baseRevisionId": {
            "type": "string",
            "minLength": 1
          },
          "baseManifestHash": {
            "type": "string",
            "minLength": 1
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "taskId",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "taskId": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  }
}
